# OSINT Plus - Template Konfigurasi API Keys
# Salin file ini menjadi .env dan isi nilainya

# ipinfo.io token untuk Phone OSINT (gratis di ipinfo.io)
IPINFO_TOKEN=

# Have I Been Pwned API key untuk cek email breach
# Dapatkan di: haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Instagram session ID untuk fitur Instagram OSINT
# Cara mendapatkan:
#   1. Login ke Instagram di browser
#   2. Buka DevTools (F12) → Application → Cookies → instagram.com
#   3. Salin nilai cookie bernama "sessionid"
INSTAGRAM_SESSIONID=
